{
  "manifest_version": 3,
  "name": "Duplicate Tab Guard",
  "version": "1.1.0",
  "description": "Keeps one tab per exact URL. Local only, no network, no data collected.",
  "permissions": ["tabs"],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Duplicate Tab Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
}
